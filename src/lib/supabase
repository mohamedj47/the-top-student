import { createClient } from '@supabase/supabase-js';

/**
 * محرك الربط مع Supabase
 * يتم استخراج القيم من process.env التي يتم حقنها بواسطة Vite
 */
const getEnv = (key: string): string => {
  if (typeof process !== 'undefined' && process.env && process.env[key]) {
    return process.env[key] as string;
  }
  return '';
};

const supabaseUrl = getEnv('SUPABASE_URL') || getEnv('NEXT_PUBLIC_SUPABASE_URL');
const supabaseAnonKey = getEnv('SUPABASE_ANON_KEY') || getEnv('NEXT_PUBLIC_SUPABASE_ANON_KEY');

export const supabase = (supabaseUrl && supabaseAnonKey)
  ? createClient(supabaseUrl, supabaseAnonKey)
  : null;

export const isSupabaseConnected = () => {
  return !!supabase;
};

export const getSupabaseStatus = () => {
  const keyStr = supabaseAnonKey || '';
  return {
    hasUrl: !!supabaseUrl,
    hasKey: !!keyStr,
    isConnected: !!supabase,
    isKeyFormatCorrect: keyStr.startsWith('eyJ'),
    isStripeKeyDetected: keyStr.startsWith('sk_') || keyStr.startsWith('pk_') || keyStr.startsWith('sb_')
  };
};
