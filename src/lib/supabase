import { createClient } from '@supabase/supabase-js';

// Access variables safely from define-injected process.env
const getEnvVar = (name: string) => {
  try {
    return (typeof process !== 'undefined' && process.env) ? process.env[name] : '';
  } catch {
    return '';
  }
};

const supabaseUrl = getEnvVar('SUPABASE_URL') || getEnvVar('NEXT_PUBLIC_SUPABASE_URL') || '';
const supabaseAnonKey = getEnvVar('SUPABASE_ANON_KEY') || getEnvVar('NEXT_PUBLIC_SUPABASE_ANON_KEY') || '';

export const supabase = (supabaseUrl && supabaseAnonKey)
  ? createClient(supabaseUrl, supabaseAnonKey)
  : null;

export const isSupabaseConnected = () => !!supabase;

export const getSupabaseStatus = () => {
  const key = supabaseAnonKey || '';
  return {
    hasUrl: !!supabaseUrl,
    hasKey: !!key,
    isConnected: !!supabase,
    isKeyFormatCorrect: key.startsWith('eyJ'),
    isStripeKeyDetected: key.startsWith('sk_') || key.startsWith('pk_') || key.startsWith('sb_')
  };
};
