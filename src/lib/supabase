// src/lib/supabase.ts
import { createClient } from '@supabase/supabase-js';

/**
 * جلب متغير البيئة بشكل آمن
 * يدعم Vite (import.meta.env) و Node/Vercel (process.env)
 */
function getEnv(key) {
  // Vite
  try {
    if (typeof import.meta !== 'undefined' && import.meta.env) {
      return import.meta.env[key] || import.meta.env[`VITE_${key}`] || '';
    }
  } catch (e) {
    // تجاهل لو import.meta غير موجود
  }

  // Node/Vercel
  if (typeof process !== 'undefined' && process.env) {
    return process.env[key] || '';
  }

  return '';
}

// Supabase URL و ANON KEY
const supabaseUrl = getEnv('SUPABASE_URL') || getEnv('VITE_SUPABASE_URL') || '';
const supabaseAnonKey = getEnv('SUPABASE_ANON_KEY') || getEnv('VITE_SUPABASE_ANON_KEY') || '';

// إنشاء العميل أو null إذا البيئة ناقصة
export const supabase = supabaseUrl && supabaseAnonKey
  ? createClient(supabaseUrl, supabaseAnonKey)
  : null;

/**
 * تحقق إذا Supabase مهيأ وجاهز
 */
export function isSupabaseConfigured() {
  return !!(supabaseUrl && supabaseAnonKey && supabase);
}

/**
 * تحقق سريع من حالة Supabase (يمكنك التوسع لاحقًا)
 */
export function getSupabaseStatus() {
  return {
    hasUrl: !!supabaseUrl && supabaseUrl.startsWith('http'),
    hasKey: !!supabaseAnonKey && supabaseAnonKey.length > 20,
    isConnected: !!supabase
  };
}
