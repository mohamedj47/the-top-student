// src/lib/supabase.ts
import { createClient } from '@supabase/supabase-js';

/**
 * الحصول على قيمة متغير البيئة بشكل آمن
 * يدعم Vite و Node/Vercel
 */
function getEnv(key) {
  // جرب import.meta.env أولًا (Vite)
  try {
    if (typeof import.meta !== 'undefined' && import.meta.env) {
      const metaEnv = import.meta.env;
      return metaEnv[key] || metaEnv[`VITE_${key}`] || '';
    }
  } catch (e) {
    // تجاهل لو import.meta غير موجود
  }

  // fallback لـ Node/Vercel
  if (typeof process !== 'undefined' && process.env) {
    return process.env[key] || '';
  }

  return '';
}

// جلب URL و Key من البيئة
const supabaseUrl = getEnv('SUPABASE_URL') || getEnv('NEXT_PUBLIC_SUPABASE_URL');
const supabaseAnonKey = getEnv('SUPABASE_ANON_KEY') || getEnv('NEXT_PUBLIC_SUPABASE_ANON_KEY');

// إنشاء العميل أو null لو البيئة ناقصة
export const supabase =
  supabaseUrl && supabaseAnonKey && supabaseUrl.startsWith('http')
    ? createClient(supabaseUrl, supabaseAnonKey)
    : null;

// تحقق الاتصال
export function isSupabaseConnected() {
  return !!supabase;
}

// حالة Supabase كاملة
export function getSupabaseStatus() {
  const keyStr = supabaseAnonKey || '';
  const urlStr = supabaseUrl || '';
  return {
    hasUrl: !!urlStr && urlStr.startsWith('http'),
    hasKey: !!keyStr && keyStr.length > 20,
    isConnected: !!supabase,
    isKeyFormatCorrect: keyStr.startsWith('eyJ'), // JWT
    isStripeKeyDetected:
      keyStr.startsWith('sk_') || keyStr.startsWith('pk_') || keyStr.startsWith('sb_')
  };
}
